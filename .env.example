HTTP_ADDR=:8080
DATABASE_URL=postgres://queue:queue@postgres:5432/queue?sslmode=disable
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
QUEUE_NAME=jobs.default
QUEUE_NAMES=jobs.default,jobs.high
WORKER_CAPABILITIES=echo,sleep,command
WORKER_ID=
WORKER_CONCURRENCY=4
WORKER_METRICS_ADDR=:9091
LEASE_DURATION=30s
OUTBOX_POLL_INTERVAL=500ms
SCHEDULER_POLL_INTERVAL=1s
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_INSECURE=true
WEB_SESSION_DURATION=8h
WEB_SESSION_SECURE_COOKIE=false
